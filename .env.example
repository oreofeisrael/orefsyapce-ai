# Copy this file to .env and add your OpenRouter key to enable live responses.
OPENROUTER_API_KEY=replace-with-server-secret
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Orefyspace AI
GEMINI_API_KEY=
GROQ_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_MODELS=
PROVIDER_FALLBACK_CHAIN=groq:openai/gpt-oss-20b,openrouter:openrouter/free
DATABASE_URL=
DATABASE_SSL=true
OPENROUTER_TIMEOUT_MS=45000
OPENROUTER_MAX_OUTPUT_TOKENS=4096
MAX_REQUEST_BYTES=1000000
MAX_MESSAGES=50
MAX_MESSAGE_CHARS=20000
MAX_CONVERSATION_CHARS=100000
CHAT_RATE_WINDOW_MS=600000
CHAT_RATE_LIMIT=30
PORT=3000
